node_modules/
dist/
.vercel/

# Local environment values. .env.example is the committed template.
.env
.env.local
.env*.local

# Build/test artifacts
*.log
.DS_Store
coverage/
# Content hashes of SVGs scripts/optimize-svgs.js has already optimised. Purely a
# build accelerator: deleting it costs one slow build, never a wrong one.
.svgo-cache.json

# Generated by `npm run build:icons` — never edit by hand, don't commit.
# raw-svgs/ IS committed: it is the source of truth (where you drop new/custom
# SVGs), so the build is reproducible offline. src/types.ts is hand-written.
src/icons/
src/index.ts
docs/icons.json
docs/genie-bundle.js

# The import's two working trees, neither of them source.
#
# .icon-sources/ holds shallow clones of the upstream icon repos, made by
# `npm run fetch:sources` and read only while importing. It was untracked rather
# than ignored, which left 1.9 GB that `git add -A` would have offered to commit.
# raw-svgs-incoming/ is where an import stages artwork before merge-sources.js
# moves it into raw-svgs/; it is meant to be compared against raw-svgs/ and then
# discarded. Deleting either costs a re-fetch, never source.
.icon-sources/
raw-svgs-incoming/
